    uuid id PK
    uuid usuario_id FK
    text metodo
    text segredo_criptografado
    boolean ativo
    timestamptz criado_em
  }
  sessao_autenticacao {
    uuid id PK
    uuid usuario_id FK
    text token_hash UK
    inet ip_origem
    text user_agent
    timestamptz criado_em
    timestamptz expira_em
    timestamptz revogado_em
  }
  papel {
    uuid id PK
    text nome UK
    text descricao
    text escopo
    timestamptz criado_em
  }
  permissao {
    uuid id PK
    text chave UK
    text descricao
    timestamptz criado_em
  }
