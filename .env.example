# Copie para .env (que o Git ignora) e preencha. Nunca coloque segredos reais neste arquivo.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Conexão da API com o banco, usando o papel de login clean_air_api (NOINHERIT).
# Ele não tem privilégio próprio: cada transação assume clean_air_auth ou clean_air_app.
# Como criá-lo: README.md, seção "API".
#
# ATENÇÃO: o `npm run db:migrate` / `db:rollback` lê esta MESMA variável, mas precisa de um usuário
# administrativo (que cria papéis e tabelas). Rode as migrations apontando para ele, sem alterar o .env:
#   DATABASE_URL=postgres://usuario-admin:senha@localhost:5432/clean_air npm run db:migrate
DATABASE_URL=postgres://clean_air_api:troque-esta-senha@localhost:5432/clean_air
# true quando o banco exige TLS (Supabase)
DATABASE_SSL=false

# Chave do HMAC que protege os códigos de recuperação. Mínimo de 32 caracteres. Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SEGREDO_CODIGOS=

# Origens do front aceitas além das padrão (github.io do Daniel, localhost:8081 e localhost:19006).
# Separe por vírgula.
CORS_ORIGINS=
# true atrás de proxy (Render), para o IP real vir de X-Forwarded-For.
TRUST_PROXY=false

# console: só desenvolvimento, escreve o código no terminal. smtp: envia de verdade (obrigatório em produção).
EMAIL_MODE=console
EMAIL_FROM=Clean Air Tech <seu-email@gmail.com>
SMTP_HOST=
SMTP_PORT=587
# true para a porta 465 (TLS direto); false para 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Ajustes opcionais (os valores abaixo são os padrões)
# SESSAO_DIAS=7
# RECUPERACAO_PEDIDOS_POR_HORA=3
# LIMITE_GLOBAL_POR_MINUTO=120
# ATRASO_MINIMO_MS=250
# ARGON2_MEMORIA_KIB=19456
